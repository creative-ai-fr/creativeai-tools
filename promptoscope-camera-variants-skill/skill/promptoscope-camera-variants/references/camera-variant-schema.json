{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creativeai.fr/schemas/promptoscope/camera-variant/1.0.0.json",
  "title": "Promptoscope camera variant sidecar",
  "description": "An optional camera-view prompt linked to, but separate from, the Promptoscope 1.0 source analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variant_schema_version",
    "variant_id",
    "source_analysis_id",
    "camera",
    "preserve",
    "prompt"
  ],
  "properties": {
    "variant_schema_version": { "type": "string", "const": "1.0" },
    "variant_id": { "type": "string", "minLength": 1 },
    "source_analysis_id": { "type": "string", "minLength": 1 },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azimuth_deg", "elevation_deg", "distance"],
      "properties": {
        "azimuth_deg": { "type": "integer", "minimum": -180, "maximum": 180 },
        "elevation_deg": { "type": "integer", "minimum": -90, "maximum": 90 },
        "distance": { "type": "string", "enum": ["close", "medium", "wide"] }
      }
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["subject", "setting", "lighting", "style", "color_palette"]
      },
      "uniqueItems": true
    },
    "prompt": { "type": "string", "minLength": 3 }
  }
}
